{
  "ConnectionStrings": {
    "OrdersDb": "Server=.;Database=OrderProcessing;Trusted_Connection=True;TrustServerCertificate=True",
    "InventoryDb": "Server=.;Database=OrderProcessing;Trusted_Connection=True;TrustServerCertificate=True",
    "PricingDb": "Server=.;Database=OrderProcessing;Trusted_Connection=True;TrustServerCertificate=True",
    "PaymentsDb": "Server=.;Database=OrderProcessing;Trusted_Connection=True;TrustServerCertificate=True",
    "ShippingDb": "Server=.;Database=OrderProcessing;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Authentication": {
    "Jwt": {
      "Authority": "https://your-identity-provider.com",
      "Audience": "order-processing-api",
      "RequireHttpsMetadata": true
    }
  },
  "ExternalServices": {
    "Inventory": {
      "BaseUrl": "https://inventory-api.example.com",
      "TimeoutSeconds": 30
    },
    "Payment": {
      "BaseUrl": "https://payment-api.example.com",
      "TimeoutSeconds": 30
    },
    "PaymentGateway": {
      "BaseUrl": "https://gateway.example.com",
      "TimeoutSeconds": 30
    },
    "Shipping": {
      "BaseUrl": "https://shipping-api.example.com",
      "TimeoutSeconds": 30
    },
    "ShippingCarrier": {
      "BaseUrl": "https://carrier.example.com",
      "TimeoutSeconds": 30
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*"
}
